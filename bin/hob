#!/bin/sh
set -eu

usage() {
  printf '%s\n' 'Usage: hob [directory]'
  printf '%s\n' 'Open a local directory as a project in Hobgoblin for macOS.'
}

if [ "$#" -gt 1 ]; then
  printf '%s\n' 'hob: Expected at most one directory' >&2
  exit 2
fi

case "${1-}" in
  -h|--help)
    usage
    exit 0
    ;;
  -*)
    printf 'hob: Unknown option: %s\n' "$1" >&2
    usage >&2
    exit 2
    ;;
esac

if [ "$(uname -s)" != 'Darwin' ]; then
  printf '%s\n' 'hob: this command is macOS only' >&2
  exit 1
fi

target=${1:-.}
if [ ! -d "$target" ]; then
  printf 'hob: Directory does not exist: %s\n' "$target" >&2
  exit 2
fi

absolute_path=$(cd "$target" && pwd -L)
exec open -b hobgoblin.app "$absolute_path"
